# Copy to .env and fill in. All are optional -- unset infra values make the
# corresponding MCP tools raise clear "not configured" errors instead of
# faking data.

WARDEN_ENVIRONMENT=development
WARDEN_WEBHOOK_SIGNING_SECRET=change-me-dev-secret
WARDEN_APPROVAL_API_KEY=change-me-dev-key

WARDEN_ANTHROPIC_API_KEY=
WARDEN_ANTHROPIC_MODEL=claude-sonnet-4-6

# Leave unset to use in-cluster config or ~/.kube/config
WARDEN_KUBECONFIG_PATH=
WARDEN_K8S_NAMESPACE_DEFAULT=default

WARDEN_ELASTICSEARCH_URL=
WARDEN_ELASTICSEARCH_API_KEY=
WARDEN_ELASTICSEARCH_INDEX=app-logs-*

WARDEN_GITHUB_TOKEN=
WARDEN_GIT_WORKDIR=/tmp/warden-repos

WARDEN_MCP_TRANSPORT=stdio

# --- Pod analytics (Grafana-style dashboard at http://localhost:3000/metrics) ---
# kubernetes = real cluster (needs kubeconfig + metrics-server for CPU/memory)
# demo       = clearly-labelled synthetic data, to explore the UI without a cluster
WARDEN_METRICS_SOURCE=kubernetes
WARDEN_METRICS_ENABLED=true
WARDEN_METRICS_SCRAPE_INTERVAL_SECONDS=15
WARDEN_METRICS_RETENTION_MINUTES=360
# "" = default namespace, "*" = all namespaces, or "prod,staging".
# Any namespace picked in the UI is collected from then on.
WARDEN_METRICS_NAMESPACES=
# Optional: long history (24h+), network I/O and CPU-throttling panels
WARDEN_PROMETHEUS_URL=

# --- Login ---
# Accounts live in a local SQLite file. The FIRST account you create on the login page is yours.
WARDEN_AUTH_REQUIRED=true
# Signs session tokens. Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (startup refuses the default) when WARDEN_ENVIRONMENT=production.
WARDEN_AUTH_SECRET=change-me-dev-auth-secret
WARDEN_AUTH_TOKEN_TTL_MINUTES=720
# Set false after creating your accounts to stop anyone else registering.
WARDEN_AUTH_ALLOW_SIGNUP=true
WARDEN_DATABASE_PATH=data/warden.db

# --- AI assistant (uses the same Gemini key as the agent) ---
# WARDEN_GEMINI_API_KEY=...
# WARDEN_GEMINI_MODEL=gemini-2.5-flash

